{
  "name": "bereree-integrado",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "npm run test:server && npm run test:app",
    "admin:create": "node --env-file-if-exists=.env server/create-admin.js",
    "owner:create": "node --env-file-if-exists=.env server/create-owner.js",
    "backup:create": "node --env-file-if-exists=.env server/operations-cli.js backup",
    "backup:restore": "node --env-file-if-exists=.env server/operations-cli.js restore",
    "metrics:snapshot": "node --env-file-if-exists=.env server/operations-cli.js snapshot",
    "check:performance": "node scripts/performance.js",
    "check:deployment": "node --env-file-if-exists=.env scripts/verify-shop-deployment.js",
    "test:browsers": "node scripts/run-browsers.js",
    "browsers:install": "node scripts/run-browsers.js install",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/routes.mjs",
    "test:app": "vitest run",
    "test:server": "node --test test/shop-integration.test.js test/store.test.js test/management.test.js test/commerce.test.js test/analytics-operations.test.js",
    "check:app": "node scripts/check.mjs"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "@fontsource/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "lucide-react": "1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "30.1.2",
    "vitest": "5.0.3"
  }
}
